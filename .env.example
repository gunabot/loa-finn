# Required
ANTHROPIC_API_KEY=sk-ant-...

# R2 Storage (required for production)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=loa-finn-data

# Git (optional, for git sync tier)
GIT_TOKEN=

# Server
PORT=3000
HOST=0.0.0.0

# Discord (thread workflow + interview control)
DISCORD_ENABLED=false
DISCORD_BOT_TOKEN=
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
DISCORD_ALLOWED_CHANNEL_IDS=

# Discord voice intake (stub)
DISCORD_VOICE_ENABLED=false
DISCORD_VOICE_ACCEPT_AUDIO_TYPES=audio/wav,audio/mpeg,audio/ogg,audio/webm
DISCORD_VOICE_TRANSCRIBE_PROVIDER=todo
DISCORD_VOICE_TRANSCRIBE_MODEL=todo

# Discord build/runtime loop
DISCORD_PROJECTS_ROOT=projects
DISCORD_BUILD_AGENT_MODEL=gpt-5.3-codex
# Optional explicit command template with placeholders:
#   {RUN_ID} {PROJECT_DIR} {PRD_PATH}
# Example:
# DISCORD_BUILD_COMMAND=codex --model gpt-5.3-codex \"Implement from {PRD_PATH} in {PROJECT_DIR}\"
DISCORD_BUILD_COMMAND=

# Agent
MODEL=claude-opus-4-6
THINKING_LEVEL=medium

# Data
DATA_DIR=/data

# Auth (required for production)
FINN_AUTH_TOKEN=
FINN_CORS_ORIGINS=localhost:*
FINN_ALLOW_BASH=false
FINN_RATE_LIMIT_WINDOW_MS=60000
FINN_RATE_LIMIT_MAX=60


# Scheduler intervals
SYNC_INTERVAL_MS=30000
GIT_SYNC_INTERVAL_MS=3600000
HEALTH_INTERVAL_MS=300000

# Identity
BEAUVOIR_PATH=grimoires/loa/BEAUVOIR.md

# Git sync
GIT_REMOTE=origin
GIT_BRANCH=main
GIT_ARCHIVE_BRANCH=finn/archive
